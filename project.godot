; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="GirlJam4-2026"
run/main_scene="res://Scenes/Screens/MainMenu.tscn"
config/icon="res://icon.png"

[autoload]

SceneManager="*res://Scripts/Managers/SceneManager.cs"
GameManager="*res://Scripts/Managers/GameManager.cs"
AudioManager="*res://Scripts/Managers/AudioManager.cs"
OutfitManager="*res://Scripts/Managers/OutfitManager.cs"
AdventurerManager="*res://Scripts/Managers/AdventurerManager.cs"
DungeonManager="*res://Scripts/Managers/DungeonManager.cs"
DesignManager="*res://Scripts/Managers/DesignManager.cs"
EnemyLibrary="*res://Scripts/Enemy/EnemyLibrary.cs"

[display]

window/stretch/mode="2d"
window/stretch/aspect="keep"

[display]

window/stretch/mode="2d"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true

